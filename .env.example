# Environment Variables for QA Generator
# INSTRUCTIONS: Copy this file to .env and customize for your system
# Example: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================

# Ollama model name
MODEL_NAME=qwen2.5:14b

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Model temperature (0.0-1.0, lower = more focused)
MODEL_TEMPERATURE=0.3

# Maximum tokens to generate
MODEL_MAX_TOKENS=4096

# ============================================================================
# PROCESSING CONFIGURATION
# ============================================================================

# QA pairs per page multiplier (2.0 = 2 QA pairs per page)
QA_MULTIPLIER=2.0

# Fixed QA count per book (leave empty to use multiplier instead)
TARGET_QA_COUNT=

# Text chunk size in characters
CHUNK_SIZE=4000

# Chunk overlap in characters
CHUNK_OVERLAP=400

# Rate limit delay between API calls in seconds
RATE_LIMIT_DELAY=0.5

# ============================================================================
# PATHS CONFIGURATION - CUSTOMIZE THESE FOR YOUR SYSTEM
# ============================================================================

# Input PDF folder
# IMPORTANT: Use forward slashes (/) or double backslashes (\\)
# Examples:
#   Windows: C:/Users/YourName/Documents/pdfs
#   Windows: C:\\Users\\YourName\\Documents\\pdfs
#   Linux/Mac: /home/username/pdfs
#   Relative: ./input
INPUT_FOLDER=./input

# Output JSONL folder (relative to project root or absolute path)
# Examples:
#   Relative: ./data/output_qwen
#   Windows: C:/Users/YourName/Documents/output
#   Linux/Mac: /home/username/output
OUTPUT_FOLDER=./data/output_qwen

# Log file path (relative to project root or absolute path)
LOG_FILE=qa_generation.log

# ============================================================================
# RESUME CONFIGURATION
# ============================================================================

# Enable resume from checkpoint (true/false)
# Set to false to always start fresh
RESUME_ENABLED=true

# ============================================================================
# DOMAIN CONFIGURATION
# ============================================================================

# Domain name for prompts (customize for your use case)
DOMAIN_NAME=Jyotish (Vedic Astrology)

# Special domain instructions (customize for your domain)
DOMAIN_SPECIAL_INSTRUCTIONS=Preserve ALL Sanskrit terms with their exact diacritical marks (ā, ī, ū, ṛ, ṣ, ś, ñ, etc.)
