# Environment Variables for QA Generator
# Copy this file to .env and customize as needed

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================

# Ollama model name
MODEL_NAME=qwen2.5:14b

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Model temperature (0.0-1.0)
MODEL_TEMPERATURE=0.3

# Maximum tokens to generate
MODEL_MAX_TOKENS=4096

# ============================================================================
# PROCESSING CONFIGURATION
# ============================================================================

# QA pairs per page multiplier
QA_MULTIPLIER=2.0

# Fixed QA count per book (leave empty to use multiplier)
TARGET_QA_COUNT=

# Text chunk size
CHUNK_SIZE=4000

# Chunk overlap
CHUNK_OVERLAP=400

# Rate limit delay (seconds)
RATE_LIMIT_DELAY=0.5

# ============================================================================
# PATHS CONFIGURATION
# ============================================================================

# Input PDF folder (use forward slashes or escaped backslashes)
INPUT_FOLDER=c:/LLM/tools/pdf_rag_in_out/input

# Output JSONL folder (relative path from project root)
OUTPUT_FOLDER=data/output_qwen

# Log file path
LOG_FILE=qa_generation.log

# ============================================================================
# RESUME CONFIGURATION
# ============================================================================

# Enable resume from checkpoint (true/false)
RESUME_ENABLED=true

# ============================================================================
# DOMAIN CONFIGURATION
# ============================================================================

# Domain name for prompts
DOMAIN_NAME=Jyotish (Vedic Astrology)

# Special domain instructions
DOMAIN_SPECIAL_INSTRUCTIONS=Preserve ALL Sanskrit terms with their exact diacritical marks (ā, ī, ū, ṛ, ṣ, ś, ñ, etc.)
